{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "mvn -DskipTests package"
  },
  "deploy": {
    "startCommand": "java -jar target/recce-studio-backend-0.0.1-SNAPSHOT.jar",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
