{
  "name": "recce-studio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:railway": "node server.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "node ../tools/quality-check.mjs lint",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.e2e.json",
    "test:targeted": "node ../tools/run-targeted-tests.mjs",
    "test:quick": "npm run test:targeted",
    "test:integration": "ng test --watch=false --browsers=ChromeHeadless --include=src/app/**/*.component.spec.ts",
    "test:unit": "ng test --watch=false --browsers=ChromeHeadless",
    "test:e2e": "node --test ../tools/run-e2e.test.mjs && node ../tools/run-e2e.mjs",
    "audit:security": "node ../tools/quality-check.mjs security",
    "audit:accessibility": "node ../tools/quality-check.mjs accessibility",
    "audit:resilience": "node ../tools/quality-check.mjs resilience",
    "quality:fast": "npm run lint && npm run typecheck && npm run test:targeted",
    "quality:standard": "npm run quality:fast && npm run test:integration && npm run test:e2e && npm run build",
    "quality:deep:extras": "npm run test:unit && npm run audit:security && npm run audit:accessibility && npm run audit:resilience",
    "quality:deep": "npm run quality:standard && npm run quality:deep:extras",
    "gate:ticket": "node ../tools/run-quality-gate.mjs ticket AUTO",
    "gate:ticket:fast": "node ../tools/run-quality-gate.mjs ticket FAST",
    "gate:ticket:standard": "node ../tools/run-quality-gate.mjs ticket STANDARD",
    "gate:ticket:deep": "node ../tools/run-quality-gate.mjs ticket DEEP",
    "gate:release": "node ../tools/run-quality-gate.mjs release AUTO",
    "gate:release:fast": "node ../tools/run-quality-gate.mjs release FAST",
    "gate:release:standard": "node ../tools/run-quality-gate.mjs release STANDARD",
    "gate:release:deep": "node ../tools/run-quality-gate.mjs release DEEP",
    "baseline:compare": "node ../tools/compare-quality-baseline.mjs",
    "baseline:validate": "node ../tools/compare-quality-baseline.mjs --validate",
    "factory:validate": "node ../tools/validate-factory.mjs",
    "e2e:ci": "playwright test --config=playwright.config.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.34",
    "@angular/common": "^20.3.34",
    "@angular/compiler": "^20.3.34",
    "@angular/core": "^20.3.34",
    "@angular/forms": "^20.3.34",
    "@angular/platform-browser": "^20.3.34",
    "@angular/platform-browser-dynamic": "^20.3.34",
    "@angular/router": "^20.3.34",
    "@angular/service-worker": "^20.3.34",
    "leaflet": "1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.41",
    "@angular/cli": "^20.3.41",
    "@angular/compiler-cli": "^20.3.34",
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "1.9.21",
    "autoprefixer": "^10.5.4",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "overrides": {
    "webpack-dev-middleware": "^7.4.6"
  }
}
